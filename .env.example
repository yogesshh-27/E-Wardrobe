# ==============================================================================
# WARDROBE AI — MASTER PRODUCTION & SECURITY ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env.local for development.

# --- APPLICATION ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="WARDROBE AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- RELATIONAL DATABASE & PGVECTOR ---
DATABASE_URL="postgresql://wardrobe_user:your_secure_password@localhost:5432/wardrobe_ai?sslmode=prefer"
PGVECTOR_DIMENSION=1536

# --- REDIS CACHE & BACKGROUND QUEUES ---
REDIS_URL="redis://:your_redis_password@localhost:6379/0"

# --- OBJECT STORAGE (AWS S3 / GOOGLE CLOUD STORAGE) ---
STORAGE_PROVIDER="s3" # "s3" or "gcs"
STORAGE_BUCKET_NAME="wardrobe-ai-private-assets"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://storage.wardrobe-ai.internal"
AWS_ACCESS_KEY_ID="your_aws_access_key_placeholder"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key_placeholder"

# --- AI & VISION PROVIDERS ---
GEMINI_API_KEY="your_google_gemini_api_key_placeholder"
GEMINI_MODEL="gemini-2.5-flash"

# --- AUTHENTICATION & SECURE SESSIONS ---
AUTH_SECRET="generate_a_minimum_64_character_random_hex_secret_here"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
ALLOW_DEMO_AUTH="true"

# --- DEVSECOPS & STRIX PENETRATION TESTING ---
# Used for authorized Strix local white-box testing
STRIX_LLM="openai/gpt-4o"
LLM_API_KEY="your_llm_api_key_for_strix_testing"
